# Ralphie runtime state, created in whatever project Ralphie is planted in.
.ralphie/

# Editor and OS noise
.DS_Store
*.swp

# Optional development evidence: sync only the reviewed, linked bundle below.
# New Graphify exports, caches, local paths and scratch receipts stay local until
# explicitly reviewed. Do not use a repository-wide *.json or *.log exclusion.
